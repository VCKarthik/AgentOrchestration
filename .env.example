# ── LLM API Keys ───────────────────────────────────────────────────────────────

# Google Gemini API key — one key, two var names (different agents use different names)
# Set BOTH to the same value from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here   # read by: IAA, DA, RRA (LangChain path)
GEMINI_API_KEY=your_google_ai_studio_key_here   # read by: RRA (genai client), SWA

# OpenAI — used by IAA when LLM_PROVIDER=openai (gpt-4o-mini)
OPENAI_API_KEY=

# RRA optional fallback providers (only needed if switching RRA summarizer)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── LLM Provider Selection ─────────────────────────────────────────────────────

# IAA model provider: "gemini" (default) or "openai" (gpt-4o-mini, faster)
# Switch to openai to reduce IAA latency from ~30-60s to ~3-8s
LLM_PROVIDER=gemini

# Gemini model used by IAA when LLM_PROVIDER=gemini
# gemini-2.0-flash  → faster (~5-10s), good quality  [default]
# gemini-2.5-flash  → slower (~15-30s), higher quality
GEMINI_MODEL=gemini-2.0-flash

# ── LangSmith Tracing (optional — free tier) ───────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true only when actively tracing — leave false otherwise to save quota.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=amp-orchestrator
# Use a separate project for eval runs so they don't pollute your main trace view:
# LANGCHAIN_PROJECT=amp-eval

# ── IAA Qdrant Vector Store ────────────────────────────────────────────────────
# Local file-backed mode (default). Path is relative to CWD — keep as ./IAA/qdrant_store
# when running from project root via uvicorn.
QDRANT_PATH=./IAA/qdrant_store

# Docker Compose / remote Qdrant server mode.
# Set QDRANT_HOST to switch from local file mode to network mode.
# Leave blank to use QDRANT_PATH instead.
QDRANT_HOST=
QDRANT_PORT=6333

# IAA prediction audit log path (JSONL — one record per /predict call)
LOG_FILE=./IAA/data/predictions.jsonl

# ── GPA (Governance & Policy Agent) ───────────────────────────────────────────
# Defaults to local SQLite — set to a postgres:// URL for production use.
DATABASE_URL=sqlite:///./GPA/governance_agent.db
UPLOAD_DIR=uploads

# ── SWA (Shadow Work Agent) SQLite ────────────────────────────────────────────
# Orchestrator imports SWA directly (no HTTP). DB lives next to repo root by default.
# DB_PATH=infra/swa.db

# ── SWA Pattern Detection Thresholds (optional overrides) ──────────────────────
# These have sensible defaults in SWA/config/settings.py — only set if tuning.
# ANALYSIS_WINDOW_DAYS=90
# MIN_REPETITION_THRESHOLD=3
# MIN_REGULARITY_SCORE=0.7
# CONFIDENCE_THRESHOLD=0.75

# ── SWA ML Clustering Thresholds (optional overrides) ──────────────────────────
# DBSCAN_EPS=1.2
# DBSCAN_MIN_SAMPLES=5
# ML_MIN_EVENTS=100
# ML_MIN_CASES=10
