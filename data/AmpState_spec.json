{
  "_spec": "AmpState canonical JSON — all fields annotated with type, stage, and governing decision",
  "_version": "1.0.0",

  "task_intake": {
    "task_id":          "str — populated by ORCHESTRATOR — intake",
    "case_id":          "str — populated by ORCHESTRATOR — intake",
    "case_type":        "str — populated by ORCHESTRATOR — intake (vendor_onboarding | claim_review | fraud_investigation | ...)",
    "task_type":        "str — populated by ORCHESTRATOR — intake (TaskType enum: claim_review | vendor_onboarding | compliance_review | financial_approval | general | ...)",
    "title":            "str — populated by ORCHESTRATOR — intake",
    "description":      "str — populated by ORCHESTRATOR — intake",
    "requester":        "str — populated by ORCHESTRATOR — intake",
    "requester_role":   "str | null — populated by ORCHESTRATOR — intake",
    "priority":         "str — populated by ORCHESTRATOR — intake (critical | high | medium | low)",
    "urgency":          "str — populated by ORCHESTRATOR — intake (immediate | urgent | moderate | low)",
    "estimated_effort": "float — populated by ORCHESTRATOR — intake (hours)",
    "due_date":         "ISO8601 datetime — populated by ORCHESTRATOR — intake",
    "business_domain":  "str — populated by ORCHESTRATOR — intake",
    "timestamp":        "ISO8601 datetime — populated by ORCHESTRATOR — intake"
  },

  "csa_output": {
    "_stage": "Stage 1 — CSA",
    "_decision": "D2",
    "task_id":   "str — run ID generated by CSA (CSA-YYYYMMDDHHMMSS-XXXXXX)",
    "task_text": "str — the query text or auto-generated label",
    "case_id":   "str | null — from CSA lookup",
    "case_type": "str | null — from CSA lookup",
    "timestamp": "ISO8601 datetime — when CSA ran",
    "context": {
      "emails": [
        {
          "id": "str", "case_id": "str", "case_type": "str",
          "subject": "str", "sender": "str", "recipients": "str",
          "date": "str", "body": "str", "attachments": "list[str]",
          "thread_id": "str | null", "file_path": "str | null", "file_link": "str | null"
        }
      ],
      "documents": [
        {
          "id": "str", "case_id": "str", "case_type": "str",
          "filename": "str", "file_type": "str", "description": "str",
          "tags": "list[str]", "created_at": "str",
          "file_path": "str | null", "file_link": "str | null"
        }
      ],
      "calendar_events": [
        {
          "id": "str", "case_id": "str", "case_type": "str",
          "title": "str", "start_time": "str", "end_time": "str",
          "attendees": "list[str]", "location": "str | null",
          "description": "str | null", "status": "str | null"
        }
      ],
      "case_history": [
        {
          "id": "str", "case_id": "str", "case_type": "str",
          "event_type": "str", "actor": "str | null",
          "timestamp": "str", "notes": "str | null", "status": "str | null"
        }
      ]
    },
    "validation": {
      "status":           "str (COMPLETE | PARTIAL | EMPTY)",
      "missing_fields":   "list[str] — source types with zero records",
      "warnings":         "list[str] — data quality warnings",
      "confidence_score": "float 0.0–1.0",
      "total_sources":    "int — total records retrieved"
    },
    "meta": {
      "total_sources":    "int",
      "sql_hits":         "int",
      "qdrant_hits":      "int",
      "keywords_used":    "list[str]",
      "retrieval_method": "str (exact_match_sql | hybrid_sql_qdrant)",
      "csa_version":      "str — e.g. '2.0.0'"
    }
  },

  "risk_output": {
    "_stage": "Stage 2a — RRA",
    "_decision": "D3",
    "task_id":             "str — from CaseInput.task_id",
    "workflow_state":      "str",
    "priority":            "str | null",
    "risk_flags":          "list[str] — ORCHESTRATOR SHIM: [i.risk_type.value for i in rra_output.risk_items] (D3)",
    "overall_risk_level":  "str (low | medium | high | critical)",
    "can_proceed":         "str (proceed | caution | hold)",
    "escalate_to_human":   "bool",
    "escalation_target":   "str | null",
    "reasoning_summary":   "str",
    "operating_context":   "str (full | partial) — as reported by RRA; final value computed by orchestrator (D5)",
    "model_used":          "str (rules-only | rules-plus-llm-summary)",
    "timestamp":           "ISO8601 datetime"
  },

  "governance_output": {
    "_stage": "Stage 2b — GPA",
    "_decision": "D4 (requires_approval, approvers)",
    "task_id":           "str",
    "decision":          "str (APPROVE | ESCALATE)",
    "reason":            "str",
    "confidence":        "float 0.0–1.0",
    "requires_approval": "bool — used in D7 requires_escalation computation",
    "next_agent":        "str (delegation_agent | human_review_agent)",
    "matched_rule_ids":  "list[int]",
    "matched_chunk_ids": "list[int]",
    "approvers":         "list[str] — role/names of required approvers (D4)"
  },

  "iaa_output": {
    "_stage": "Stage 2c — IAA",
    "_decision": "D1 (context_summary deprecated), D4 (task_list feeds DA shim)",
    "predicted_actions": [
      {
        "action_id":  "str — snake_case e.g. 'request_missing_document'",
        "label":      "str — human-readable",
        "confidence": "float 0.0–1.0",
        "reasoning":  "str"
      }
    ],
    "recommended_action": {
      "action_id":  "str",
      "label":      "str",
      "confidence": "float",
      "reasoning":  "str"
    },
    "override_applied":        "bool",
    "override_reason":         "str | null",
    "retrieved_context_ids":   "list[str]",
    "escalate_to_human":       "bool — used in D7",
    "operating_context":       "str (full | partial) — as reported by IAA; final value computed by orchestrator (D5)",
    "model_used":              "str e.g. 'gemini/gemini-2.5-flash'",
    "timestamp":               "ISO8601 datetime",
    "task_list": [
      {
        "task_id":       "str",
        "action":        "str — snake_case",
        "assigned_role": "str | null",
        "priority":      "str (high | medium | low)",
        "depends_on":    "list[str]",
        "reasoning":     "str"
      }
    ],
    "workflow_timeline": [
      {
        "step":       "int",
        "event_type": "str",
        "actor":      "str | null",
        "status":     "str (completed | current | predicted)",
        "timestamp":  "ISO8601 datetime | null"
      }
    ]
  },

  "da_output": {
    "_stage": "Stage 3 — DA",
    "_decision": "D4 (input built by orchestrator shim), D7 (escalation_required)",
    "assignment_id":       "str — e.g. ASN-XXXXXXXXXX",
    "task_id":             "str",
    "status":              "str (assigned | escalated | unassigned | review_required)",
    "assignment_reason":   "str | null (ownership_continuity | skill_match | workload_balance | ...)",
    "confidence_score":    "float",
    "reasons":             "list[str]",
    "selected_channel":    "str | null (human_owner | specialized_agent | automation | supervisor_review | manual_triage)",
    "selected_owner_type": "str (human | agent | system | queue | none)",
    "selected_owner":      "dict | null",
    "selected_assignee":   "dict | null",
    "candidate_rankings":  "list[dict] — top human candidates with scores",
    "decision_factors":    "dict | null",
    "escalation_required": "bool — used in D7",
    "escalation_reason":   "str | null",
    "escalation_urgency":  "str | null (immediate | urgent | moderate | low)",
    "audit_log_id":        "str | null",
    "timestamp":           "ISO8601 datetime",
    "expected_completion": "ISO8601 datetime | null",
    "orchestrator_action": "str | null"
  },

  "swa_output": {
    "_stage": "Stage 1 (async, non-blocking) — SWA",
    "_decision": "D6 (redesigned to match actual AgentOutput)",
    "run_id":               "str — e.g. sw_YYYYMMDD_HHMMSS_XXXX",
    "findings":             "list[dict] — serialized Finding objects (pattern detections with automation recommendations)",
    "escalations":          "list[dict] — serialized Escalation objects (patterns requiring human review)",
    "escalation_surfaced":  "bool — True if len(escalations) > 0",
    "summary_sent":         "bool — True if len(findings) > 0 (patterns were detected)",
    "window_analyzed": {
      "start":             "ISO8601 datetime",
      "end":               "ISO8601 datetime",
      "events_processed":  "int"
    },
    "metrics": {
      "patterns_detected":    "int",
      "recommendations_made": "int",
      "escalations_raised":   "int",
      "events_processed":     "int",
      "processing_time_ms":   "float",
      "detectors_used":       "list[str]"
    },
    "timestamp": "ISO8601 datetime — when SWA run completed"
  },

  "meta": {
    "_stage": "ORCHESTRATOR — computed after all stages complete",
    "_decisions": "D5, D7",
    "amp_version":       "str — AmpState schema version e.g. '1.0.0'",
    "run_id":            "str — orchestrator-level run identifier",
    "timestamp":         "ISO8601 datetime — orchestrator completion time",
    "operating_context": "str (full | partial) — D5: 'partial' if rra OR iaa reported partial",
    "requires_escalation": "bool — D7: true if ANY of rra.escalate_to_human | gpa.requires_approval | iaa.escalate_to_human | da.escalation_required",
    "stage_errors": {
      "_type": "dict[str, list[str]] — keyed by stage name",
      "da_merge":       "list[str] — fields defaulted during D4 shim",
      "swa_validation": "list[str] — case_history event_types not in ALL_ACTION_TYPES"
    }
  }
}
